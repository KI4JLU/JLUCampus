# ---- Server (apps/server) ----
PORT=3000
DATABASE_URL=postgres://justcampus:justcampus@127.0.0.1:5433/justcampus
# Encrypts component API keys. Generate with: openssl rand -base64 32
COMPONENT_SECRETS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Public origin of the API. Better-Auth builds its OAuth callback from it.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies.
# `app://-` is the Electron renderer's origin.
CORS_ORIGINS=http://localhost:5173,app://-
# Keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/justcampus
KEYCLOAK_CLIENT_ID=justcampus
KEYCLOAK_CLIENT_SECRET=justcampus-dev-secret
# Allow the feed proxy to reach private and loopback hosts. Development only.
FEED_ALLOW_PRIVATE_HOSTS=false
# Where Keycloak sends the browser after sign-out. Defaults to the first CORS
# origin; set it to the API origin when the API serves the web app itself.
# WEB_ORIGIN=http://localhost:5173
# Set to a directory to serve the built web app from the server (production).
# SERVE_WEB_DIR=../web/dist
# Python code blocks of the translator's editor run in a container without network, one per
# run. Build the image with `bun run sandbox:build`. PYTHON_SANDBOX_RUNTIME=runsc runs them under
# gVisor, as HAWKI does; the CLI may be podman as well. Without root (no runsc in Docker), use
# rootless Podman with gVisor: `bun run sandbox:build:podman`, `bun run sandbox:gvisor`, then
# PYTHON_SANDBOX_DOCKER=podman and PYTHON_SANDBOX_RUNTIME=<checkout>/infra/python-sandbox/runsc-rootless.
# PYTHON_SANDBOX_DOCKER=docker
# PYTHON_SANDBOX_IMAGE=justcampus-python-sandbox:latest
# PYTHON_SANDBOX_RUNTIME=runsc
# Object storage of the transcription module: MinIO from docker-compose.yml (API on 9100,
# console on http://localhost:9101). Only the server talks to it; browsers upload and play
# through the API. Without a bucket the module offers no uploads.
TRANSCRIPTION_S3_ENDPOINT=http://localhost:9100
TRANSCRIPTION_S3_REGION=us-east-1
TRANSCRIPTION_S3_BUCKET=justcampus-transcription
TRANSCRIPTION_S3_ACCESS_KEY=justcampus
TRANSCRIPTION_S3_SECRET_KEY=justcampus-dev-secret
TRANSCRIPTION_S3_FORCE_PATH_STYLE=true
# ffmpeg and ffprobe for the transcription worker, and its temporary directory.
# TRANSCRIPTION_FFMPEG=ffmpeg
# TRANSCRIPTION_FFPROBE=ffprobe
# TRANSCRIPTION_WORK_DIR=/tmp
# Live transcription sessions the server relays at once, and per person.
# TRANSCRIPTION_LIVE_MAX_SESSIONS=20
# TRANSCRIPTION_LIVE_MAX_SESSIONS_PER_USER=2
# The stand-in for speech, diarisation, chat and realtime in tests and offline development
# (`bun run mock:transcription`); the module itself uses the HRZ services.
# TRANSCRIPTION_MOCK_PORT=9200
# Outbound proxy, where the internet (the HRZ gateway, OpenAI) is reachable only through one.
# Node uses HTTPS_PROXY/HTTP_PROXY only with NODE_USE_ENV_PROXY=1 (Node 22.21 / 24.5 or later),
# for fetch, the S3 client and the live transcription's WebSocket to the gateway alike; NO_PROXY
# must name object storage, Keycloak if it is internal, and localhost. The server warns at start
# about hosts it misses.
# Through an SSH tunnel to the campus host's proxy, for example:
# HTTPS_PROXY=http://127.0.0.1:3129
# HTTP_PROXY=http://127.0.0.1:3129
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1,.ts.net

# ---- Web (apps/web) ----
# Where the browser reaches the API in development. Empty = same origin.
VITE_API_URL=http://localhost:3000

# ---- Desktop (apps/desktop) ----
# API origin baked into the desktop build; can be overridden at runtime with
# the JUSTCAMPUS_API_URL environment variable.
DESKTOP_API_URL=http://localhost:3000
# Origins besides the API the desktop app may fetch from and play media of (its CSP): the
# transcription storage's public endpoint. Live transcription needs none, it runs over the API's
# own WebSocket. Space separated; overridable at runtime with JUSTCAMPUS_CONNECT_ORIGINS.
# DESKTOP_CONNECT_ORIGINS=http://localhost:9100
