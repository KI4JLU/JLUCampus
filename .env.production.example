# Production settings for docker-compose.prod.yml. Copy to .env.production.

# ---- Compose ----
# Image tag to run: latest, a release version (1.2.3) or sha-<short>.
JUSTCAMPUS_TAG=latest
# Host address and port the app listens on; the reverse proxy forwards here.
APP_BIND=127.0.0.1
APP_PORT=3000

# ---- Postgres ----
POSTGRES_USER=justcampus
# openssl rand -hex 24 (hex avoids characters that would break DATABASE_URL)
POSTGRES_PASSWORD=
POSTGRES_DB=justcampus

# ---- MinIO (transcription audio) ----
MINIO_ROOT_USER=justcampus
# openssl rand -hex 24
MINIO_ROOT_PASSWORD=
# Host address and port MinIO listens on; the reverse proxy publishes it on its own host name.
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
TRANSCRIPTION_S3_BUCKET=justcampus-transcription
# The public HTTPS origin of MinIO, which signed upload and playback URLs point at. It needs its
# own host name: a path prefix breaks the signatures. The app reaches MinIO as http://minio:9000.
TRANSCRIPTION_S3_PUBLIC_ENDPOINT=https://storage.campus.example.uni-giessen.de
TRANSCRIPTION_S3_REGION=us-east-1
# Shared secret of the TURN servers (coturn static-auth-secret), if the transcription module's
# live mode authenticates at TURN with short-lived credentials. openssl rand -base64 32
# TRANSCRIPTION_TURN_SECRET=

# ---- On-prem live transcription (infra/realtime-bridge/README.md) ----
# Starts the realtime bridge and the coturn relay (host networking). The module's bridge address
# is then http://host.docker.internal:8089 (in NO_PROXY below, so signaling never goes through the
# outbound proxy).
# COMPOSE_PROFILES=realtime
# The bridge's BRIDGE_API_KEY; the app sends it with every request. Required: the bridge does not
# start without it. openssl rand -base64 32
# TRANSCRIPTION_REALTIME_BRIDGE_KEY=
# REALTIME_BRIDGE_PORT=8089
# Sessions at once, and when a connected one ends: no audio for IDLE_TIMEOUT_S, or after
# MAX_SESSION_S in all (4 h).
# REALTIME_BRIDGE_MAX_SESSIONS=20
# REALTIME_BRIDGE_IDLE_TIMEOUT_S=60
# REALTIME_BRIDGE_MAX_SESSION_S=14400
# The proxy the bridge reaches the gateway's WebSocket through, if the host needs one.
# REALTIME_BRIDGE_HTTPS_PROXY=http://proxy.example.uni-giessen.de:3128
# REALTIME_BRIDGE_NO_PROXY=localhost,127.0.0.1
# The bridge's own TURN client: the relay below, credentials from TRANSCRIPTION_TURN_SECRET.
# REALTIME_BRIDGE_TURN_URLS=turn:127.0.0.1:3478?transport=udp
# coturn: the address browsers reach it on goes into the module's ICE servers, such as
# turn:campus.example.uni-giessen.de:3478?transport=tcp. It relays only to this host's address,
# which the bridge advertises. Open TURN_PORT (TCP, UDP), TURN_TLS_PORT and the relay range (UDP).
# TURN_ALLOWED_PEER_IP=134.176.0.10
# TURN_REALM=campus.example.uni-giessen.de
# TURN_PORT=3478
# TURN_TLS_PORT=5349
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49250
# A directory with cert.pem and key.pem enables TLS (turns:) on TURN_TLS_PORT.
# TURN_CERT_DIR=/etc/ssl/campus-turn
# Outbound proxy, if the host reaches the HRZ gateway and other services only through one.
# Node uses it only with NODE_USE_ENV_PROXY=1, for fetch and the S3 client alike. NO_PROXY must
# name MinIO (`minio`), Keycloak if it is internal, localhost (the health check) and the realtime
# bridge (`host.docker.internal`); the app warns at start about hosts it misses, and about the
# bridge address of the module's settings when it signals.
# HTTPS_PROXY=http://proxy.example.uni-giessen.de:3128
# HTTP_PROXY=http://proxy.example.uni-giessen.de:3128
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1,minio,host.docker.internal,keycloak.example.uni-giessen.de

# ---- Server ----
# Encrypts module secrets such as API keys. openssl rand -base64 32
# Changing it later makes stored secrets unreadable.
COMPONENT_SECRETS_KEY=
# Public HTTPS origin of the app. Better-Auth builds its OAuth callback from it.
BETTER_AUTH_URL=https://campus.example.uni-giessen.de
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public origin plus `app://-` for the desktop app.
CORS_ORIGINS=https://campus.example.uni-giessen.de,app://-
# Where Keycloak sends the browser after sign-out.
WEB_ORIGIN=https://campus.example.uni-giessen.de
# Keycloak
KEYCLOAK_ISSUER=https://keycloak.example.uni-giessen.de/realms/justcampus
KEYCLOAK_CLIENT_ID=justcampus
KEYCLOAK_CLIENT_SECRET=
# Realm role that grants access to the admin panel.
KEYCLOAK_ADMIN_ROLE=admin
FEED_ALLOW_PRIVATE_HOSTS=false
